#!/usr/bin/env bash
#
# For each machine in a CSV, find its Schematics workspace (matched by
# subscription_id appearing in the workspace name) and check whether a given
# Terraform resource type is present in that workspace's state.
#
#   export SCHEMATICS_APIKEY=...
#   ./check_workspace_resource.sh -f prod_check.csv -o sailpoint.csv
#   ./check_workspace_resource.sh -f prod_check.csv -p sailpoint_ -r us-south,eu-de
#
# Input CSV must have a header row with (default names, override with flags):
#   hostname, subscription_id, account_number
# Any other columns are ignored. Quoted fields and CRLF endings are handled.
#
# Output CSV columns:
#   hostname,subscription_id,account,region,workspace_name,workspace_id,
#   found,match_count,matched_types,resource_total,detail
#
# found: YES | NO | NO_STATE | NO_WORKSPACE | NO_SUB_ID | AUTH_ERROR | HTTP_ERROR
#
# Needs: ibmcloud CLI, the schematics plugin, jq, awk.

set -uo pipefail

APIKEY="${SCHEMATICS_APIKEY:-}"
INPUT=""
OUT=""
PREFIX="sailpoint_"
REGIONS="us-south,eu-de"
HOST_COL="hostname"
SUB_COL="subscription_id"
ACCT_COL="account_number"

TMPDIR_="$(mktemp -d)"
trap 'rm -rf "$TMPDIR_"' EXIT

usage() { sed -n '3,22p' "$0" | sed 's/^# \?//'; exit "${1:-0}"; }

while [ $# -gt 0 ]; do
  case "$1" in
    -f|--file)      INPUT="$2"; shift 2 ;;
    -o|--out)       OUT="$2"; shift 2 ;;
    -k|--api-key)   APIKEY="$2"; shift 2 ;;
    -p|--prefix)    PREFIX="$2"; shift 2 ;;
    -r|--regions)   REGIONS="$2"; shift 2 ;;
    --host-col)     HOST_COL="$2"; shift 2 ;;
    --sub-col)      SUB_COL="$2"; shift 2 ;;
    --acct-col)     ACCT_COL="$2"; shift 2 ;;
    -h|--help)      usage 0 ;;
    *) echo "unknown option: $1" >&2; usage 1 ;;
  esac
done

for tool in ibmcloud jq awk; do
  command -v "$tool" >/dev/null 2>&1 || { echo "$tool not found in PATH" >&2; exit 1; }
done
[ -n "$INPUT" ] || { echo "No input CSV. Use -f." >&2; usage 1; }
[ -f "$INPUT" ] || { echo "no such file: $INPUT" >&2; exit 1; }
[ -n "$APIKEY" ] || { echo "No API key. Use -k or set SCHEMATICS_APIKEY." >&2; exit 1; }

# --- read the input CSV, emit hostname \t sub_id \t account ----------------
ROWS="$TMPDIR_/rows.tsv"
awk -v hc="$HOST_COL" -v sc="$SUB_COL" -v ac="$ACCT_COL" '
function csvsplit(line, arr,   i, n, field, inq, c) {
  n=0; field=""; inq=0
  for (i=1; i<=length(line); i++) {
    c = substr(line,i,1)
    if (inq) {
      if (c == "\"") {
        if (substr(line,i+1,1) == "\"") { field = field "\""; i++ } else inq=0
      } else field = field c
    } else {
      if (c == "\"") inq=1
      else if (c == ",") { arr[++n]=field; field="" }
      else field = field c
    }
  }
  arr[++n]=field
  return n
}
{ sub(/\r$/, "") }
NR==1 {
  n = csvsplit($0, h)
  for (i=1; i<=n; i++) {
    if (h[i]==hc) hi=i; if (h[i]==sc) si=i; if (h[i]==ac) ai=i
  }
  if (!hi || !si || !ai) {
    printf("MISSING_COLUMN\n") > "/dev/stderr"; exit 3
  }
  next
}
NF==0 { next }
{
  n = csvsplit($0, f)
  printf "%s\t%s\t%s\n", f[hi], f[si], f[ai]
}
' "$INPUT" > "$ROWS"
awk_status=$?
if [ $awk_status -eq 3 ]; then
  echo "Input CSV needs columns: $HOST_COL, $SUB_COL, $ACCT_COL" >&2
  echo "Header found: $(head -1 "$INPUT")" >&2
  exit 1
fi
[ -s "$ROWS" ] || { echo "no data rows in $INPUT" >&2; exit 1; }

# Group by account so we only switch/enumerate once per account.
sort -t$'\t' -k3,3 -k1,1 "$ROWS" -o "$ROWS"
echo "$(wc -l < "$ROWS") machine(s) across $(cut -f3 "$ROWS" | sort -u | grep -c .) account(s)" >&2

# --- CSV output helpers ----------------------------------------------------
csv_field() { printf '"%s"' "$(printf '%s' "$1" | sed 's/"/""/g')"; }
emit() { local o=""; for f in "$@"; do o="${o}$(csv_field "$f"),"; done
         if [ -n "$OUT" ]; then printf '%s\n' "${o%,}" >> "$OUT"
         else printf '%s\n' "${o%,}"; fi; }

[ -n "$OUT" ] && : > "$OUT"
emit hostname subscription_id account region workspace_name workspace_id \
     found match_count matched_types resource_total detail

# --- login -----------------------------------------------------------------
echo "logging in..." >&2
if ! login_err=$(ibmcloud login --apikey "$APIKEY" -a https://cloud.ibm.com -q 2>&1); then
  echo "login failed: $login_err" >&2; exit 1
fi
ibmcloud plugin show schematics >/dev/null 2>&1 || {
  echo "schematics plugin missing; run: ibmcloud plugin install schematics" >&2; exit 1; }

declare -A TALLY=()
bump() { TALLY["$1"]=$(( ${TALLY["$1"]:-0} + 1 )); }

CUR_ACCT=""
WS_INDEX="$TMPDIR_/workspaces.tsv"   # name \t id \t status \t region
ACCT_OK=1

while IFS=$'\t' read -r hostname sub_id account; do
  [ -n "$hostname" ] || continue

  # ---- switch account and rebuild the workspace index when it changes ----
  if [ "$account" != "$CUR_ACCT" ]; then
    CUR_ACCT="$account"
    ACCT_OK=1
    : > "$WS_INDEX"

    if ! terr=$(ibmcloud target -c "$account" -q 2>&1); then
      ACCT_OK=0
      ACCT_ERR="${terr:0:150}"
    else
      IFS=',' read -r -a region_list <<< "$REGIONS"
      for region in "${region_list[@]}"; do
        region="$(printf '%s' "$region" | tr -d '[:space:]')"
        [ -n "$region" ] || continue
        ibmcloud target -r "$region" -q >/dev/null 2>&1
        if ws_json=$(ibmcloud schematics workspace list --output json 2>&1); then
          printf '%s' "$ws_json" \
            | jq -r --arg r "$region" \
                '(.workspaces // [])[] | [.name, .id, .status, $r] | @tsv' \
            >> "$WS_INDEX" 2>/dev/null
        else
          echo "[$account/$region] workspace list failed: ${ws_json:0:120}" >&2
        fi
      done
      echo "[$account] indexed $(wc -l < "$WS_INDEX") workspace(s)" >&2
    fi
  fi

  if [ "$ACCT_OK" -eq 0 ]; then
    emit "$hostname" "$sub_id" "$account" "" "" "" AUTH_ERROR 0 "" 0 \
         "cannot target account: $ACCT_ERR"
    bump AUTH_ERROR; continue
  fi

  if [ -z "$sub_id" ]; then
    emit "$hostname" "" "$account" "" "" "" NO_SUB_ID 0 "" 0 \
         "no subscription_id in input row"
    bump NO_SUB_ID; continue
  fi

  # ---- find the workspace whose name contains the subscription id -------
  hits=$(grep -iF -- "$sub_id" "$WS_INDEX" || true)
  hit_count=$(printf '%s' "$hits" | grep -c . || true)

  if [ "$hit_count" -eq 0 ]; then
    emit "$hostname" "$sub_id" "$account" "" "" "" NO_WORKSPACE 0 "" 0 \
         "no workspace name contains this subscription_id"
    bump NO_WORKSPACE; continue
  fi

  IFS=$'\t' read -r ws_name ws_id ws_status ws_region <<< "$(printf '%s' "$hits" | head -1)"
  extra=""
  [ "$hit_count" -gt 1 ] && extra="$hit_count workspaces matched, used first; "

  # ---- pull the state list ----------------------------------------------
  ibmcloud target -r "$ws_region" -q >/dev/null 2>&1
  if ! state_out=$(ibmcloud schematics state list --id "$ws_id" 2>&1); then
    case "$state_out" in
      *"not found"*|*"No state"*|*"does not exist"*)
        emit "$hostname" "$sub_id" "$account" "$ws_region" "$ws_name" "$ws_id" \
             NO_STATE 0 "" 0 "${extra}no state stored yet"; bump NO_STATE ;;
      *401*|*403*|*naut*|*orbidden*)
        emit "$hostname" "$sub_id" "$account" "$ws_region" "$ws_name" "$ws_id" \
             AUTH_ERROR 0 "" 0 "${extra}${state_out:0:150}"; bump AUTH_ERROR ;;
      *)
        emit "$hostname" "$sub_id" "$account" "$ws_region" "$ws_name" "$ws_id" \
             HTTP_ERROR 0 "" 0 "${extra}${state_out:0:150}"; bump HTTP_ERROR ;;
    esac
    continue
  fi

  addrs=$(printf '%s\n' "$state_out" \
    | grep -E '^[a-zA-Z_][a-zA-Z0-9_.-]*\.[a-zA-Z0-9_-]+' \
    | grep -vE '^(OK|FAILED)$' || true)
  total=$(printf '%s' "$addrs" | grep -c . || true)
  matched=$(printf '%s\n' "$addrs" | grep -v '^data\.' | grep -E "(^|\.)${PREFIX}" || true)
  mcount=$(printf '%s' "$matched" | grep -c . || true)
  mtypes=$(printf '%s\n' "$matched" \
           | sed -E 's/.*(^|\.)('"${PREFIX}"'[a-zA-Z0-9_]*)\..*/\2/' \
           | sort -u | paste -sd';' -)

  if [ "$total" -eq 0 ]; then
    emit "$hostname" "$sub_id" "$account" "$ws_region" "$ws_name" "$ws_id" \
         NO_STATE 0 "" 0 "${extra}state list returned nothing"; bump NO_STATE
  elif [ "$mcount" -gt 0 ]; then
    emit "$hostname" "$sub_id" "$account" "$ws_region" "$ws_name" "$ws_id" \
         YES "$mcount" "$mtypes" "$total" "$extra"; bump YES
  else
    emit "$hostname" "$sub_id" "$account" "$ws_region" "$ws_name" "$ws_id" \
         NO 0 "" "$total" "$extra"; bump NO
  fi
done < "$ROWS"

echo "" >&2
summary=""
for k in "${!TALLY[@]}"; do summary="$summary $k=${TALLY[$k]}"; done
echo "done:${summary}" >&2
[ "${TALLY[YES]:-0}" -gt 0 ] && exit 0 || exit 1
